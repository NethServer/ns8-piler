{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump piler .deb release referenced in piler-server/Dockerfile",
      "managerFilePatterns": ["^piler-server/Dockerfile$"],
      "matchStrings": [
        "ARG PILER_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "jsuto/piler",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^piler-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bump supercronic release referenced in piler-server/Dockerfile",
      "managerFilePatterns": ["^piler-server/Dockerfile$"],
      "matchStrings": [
        "ARG SUPERCRONIC_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "aptible/supercronic",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Bump the linter images the workflows run with docker run",
      "managerFilePatterns": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "docker\\.io/(?<depName>[-0-9a-z_/.]+):(?<currentValue>[-0-9a-zA-Z_.]+)",
        "(?<depName>ghcr\\.io/[-0-9a-z_/.]+):(?<currentValue>[-0-9a-zA-Z_.]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "matchFileNames": ["piler-server/Dockerfile"],
      "versioning": "regex:^resolute-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})(\\.(?<build>\\d+))?$",
      "groupName": "ubuntu resolute base image"
    }
  ]
}
