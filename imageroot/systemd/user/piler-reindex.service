# Rebuilds the search index after a restore. It can run for hours on a large
# archive, so the restore starts it without waiting.

[Unit]
Description=Rebuild the piler search index
Requires=piler-app.service
After=piler-app.service manticore-app.service

[Service]
Type=oneshot
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
ExecStart=/usr/local/bin/runagent restore-index
SyslogIdentifier=%u
