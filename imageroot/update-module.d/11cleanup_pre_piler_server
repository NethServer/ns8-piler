set -e

# Nothing reads these. manticore.conf is the reason to bother: it holds the
# database password at mode 644, in a backed-up volume.
stale="MANTICORE manticore.conf manticore.conf.dist sphinx.conf.dist config-site.dist.php piler.conf.dist piler-nginx.conf.dist"

# "None" only for a build predating piler-server, so this runs once.
if [ "${PREV_PILER_SERVER_IMAGE:-}" != "None" ]; then
    echo "not an upgrade from a pre-piler-server build, nothing to clean up" >&2
    exit 0
fi

if ! systemctl is-active --user --quiet piler-app; then
    echo "piler-app is not running, skipping the cleanup" >&2
    exit 0
fi

found=$(podman exec piler-app sh -c "cd /etc/piler && ls -1 ${stale} 2>/dev/null" || true)

if [ -z "${found}" ]; then
    echo "no unmanaged config files left in /etc/piler" >&2
else
    echo "Removing config files this image no longer manages:" >&2
    echo "${found}" | sed 's/^/  /' >&2
    podman exec piler-app sh -c "cd /etc/piler && rm -f ${stale}"
fi
