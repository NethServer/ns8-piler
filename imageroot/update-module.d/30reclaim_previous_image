set -e

# PILER_IMAGE named the upstream image of an older layout. update-module never
# removes a variable, so this script clears it once the image is gone.
[ -n "${PILER_IMAGE:-}" ] || exit 0

echo "Reclaiming the image this module no longer runs: ${PILER_IMAGE}" >&2

# After 20restart. No -f: never pull an image from under a container.
if podman rmi "${PILER_IMAGE}" > /dev/null 2>&1; then
    python3 -c 'import agent; agent.unset_env("PILER_IMAGE")'
else
    echo "  could not remove it, leaving PILER_IMAGE in place" >&2
fi
