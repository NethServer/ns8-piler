set -e

# The old label named the upstream image in PILER_IMAGE; the unit now reads
# PILER_SERVER_IMAGE. update-module never removes a variable, so this one
# survives pointing at the image nobody runs, and nothing prunes it.
#
# Ordered after 20restart on purpose: before it, piler-app is still the old
# container on that image and rmi refuses. No -f, so it refuses rather than
# pulling an image out from under a container, and the variable is kept when it
# does - it is the only record of what to reclaim.
if [ "${PREV_PILER_SERVER_IMAGE:-}" != "None" ] || [ -z "${PILER_IMAGE:-}" ]; then
    exit 0
fi

echo "Reclaiming the image this module no longer runs: ${PILER_IMAGE}" >&2

if podman rmi "${PILER_IMAGE}" > /dev/null 2>&1; then
    python3 -c 'import agent; agent.unset_env("PILER_IMAGE")'
else
    echo "  still in use, leaving it and PILER_IMAGE in place" >&2
fi
