set -e
exec 1>&2 # Redirect any output to the journal (stderr)

# Backups taken before manticore.sql existed hold manticore-data, index included.
if [ ! -f manticore.sql ]; then
    exit 0
fi

manticore() {
    podman exec -i manticore-app mysql -h127.0.0.1 -P9306 "$@"
}

for ((i = 0; i < 120; i++)); do
    manticore -e "SHOW TABLES" >/dev/null 2>&1 && break
    echo "Waiting for manticore-app: $i ..."
    sleep 1
done
if ! manticore -e "SHOW TABLES" >/dev/null; then
    echo "manticore-app is not ready, tags, notes and audit are not restored."
    exit 1
fi

# Done here, not in piler-reindex: a failure must fail the restore.
manticore < manticore.sql
rm -vf manticore.sql

systemctl --user start --no-block piler-reindex.service
