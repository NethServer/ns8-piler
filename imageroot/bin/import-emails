#!/usr/bin/env python3

#
# Copyright (C) 2024 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

import subprocess
import sys
import os
import agent
import argparse

parser = argparse.ArgumentParser(description='Script for importing user mailboxes from an IMAP server into the mail piler archive')
parser.add_argument('-A', '--after', metavar='AFTER_TIMESTAMP', type=str,
                    help='Import emails after the specified value (unix timestamp)')
parser.add_argument('-B', '--before', metavar='BEFORE_TIMESTAMP', type=str,
                    help='Import emails before the specified value (unix timestamp)')

args = parser.parse_args()

# Handed to pilerimport as is: it compares them to the Date header to the
# second, where IMAP SEARCH only knows whole days of the arrival date.
time_filter = []
if args.after is not None:
    print("Import emails after timestamp:", args.after, file=sys.stderr)
    time_filter += ['-A', args.after]
if args.before is not None:
    print("Import emails before timestamp:", args.before, file=sys.stderr)
    time_filter += ['-B', args.before]

# piler-imap-fetch downloads each mailbox and hands it to pilerimport in
# batches; it ships in the piler-server image, which this repo builds from the
# same commit, so the two cannot drift apart.
#
# Its .eml files live on the container's writable layer: /var/piler/tmp is the
# archiver spool that piler-run.sh counts to decide the drain is done, and
# /var/piler/store is in state-include.conf so throwaway files would end up in
# a restic backup. Override only if the root disk is tight.
tmpdir = os.getenv('PILER_IMPORT_TMPDIR', '/var/piler/imap')
batch = os.getenv('PILER_IMPORT_BATCH', '20')
# 200ms between messages, as the pilerimport call this replaced already used.
# Only the import is paced: that is where the load comes from, and while a
# batch imports no IMAP traffic is going out at all. PILER_IMPORT_LOAD_LIMIT
# additionally parks the archiver while the 1 minute load average sits above
# it; 0 leaves that off.
delay_ms = os.getenv('PILER_IMPORT_DELAY_MS', '200')
la_limit = os.getenv('PILER_IMPORT_LOAD_LIMIT', '0')
# list-user-mailboxes reports root, which has no mailbox dovecot will open.
skip_users = set(filter(None, os.getenv('PILER_IMPORT_SKIP_USERS', 'root').split(',')))

rdb = agent.redis_connect()

providers = agent.list_service_providers(rdb, 'imap', 'tcp', {
    'module_uuid': os.environ['MAIL_SERVER'],
})

if providers:
    mail_id = providers[0]["module_id"]
    ip_address = providers[0]["host"]

    # retrieve the list of users
    response = agent.tasks.run(f"module/{mail_id}", action='list-user-mailboxes')
    agent.assert_exp(response['exit_code'] == 0)

    user_list = []
    for user_data in response['output'].get("user_mailboxes"):
        user = user_data["user"]
        if user in skip_users:
            print(f"### Skipped {user}, listed in PILER_IMPORT_SKIP_USERS", file=sys.stderr)
        # A disabled mailbox is listed with "enabled": false and dovecot refuses
        # its login, the user may even be gone from the account provider.
        elif not user_data.get("enabled", True):
            print(f"### Skipped {user}, mailbox is disabled", file=sys.stderr)
        else:
            user_list.append(user)

    # retrieve the vmail password
    response = agent.tasks.run(f"module/{mail_id}", action='reveal-master-credentials')
    agent.assert_exp(response['exit_code'] == 0)
    password = response['output']['password']

    for user in user_list:
        try:
            print(f"### Importing {user} to {os.environ['MODULE_ID']}", file=sys.stderr)

            # The password goes in on stdin: argv is world-readable in ps, and
            # it surfaced in a traceback when it was an argument.
            subprocess.run([
                '/usr/bin/podman', 'exec', '-i', '-u', 'piler', 'piler-app',
                '/usr/local/bin/piler-imap-fetch', ip_address, f'{user}*vmail',
                os.path.join(tmpdir, user), batch, delay_ms, la_limit, *time_filter
            ], input=password + '\n', text=True, check=True)
        except subprocess.CalledProcessError as e:
            # The child already said what went wrong; repeating str(e) would
            # dump the whole podman command line after it.
            print(f"### Skipped {user}, import exited {e.returncode}", file=sys.stderr)
            continue
        except Exception as e:
            print(f"### Error to import {user} to {os.environ['MODULE_ID']}: {e}", file=sys.stderr)
            continue
