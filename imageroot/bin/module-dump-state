# SPDX-License-Identifier: GPL-3.0-or-later
#

set -e

if ! systemctl --user -q is-active piler.service; then
    exit 0
fi

podman exec mariadb-app mysqldump \
        --databases piler \
        --default-character-set=utf8mb4 \
        --skip-dump-date \
        --ignore-table=mysql.event \
        --single-transaction \
        --quick \
        --add-drop-table  > piler.sql

# The search index is rebuilt from the store on restore, tags, notes and audit
# are not. This mysqldump is from the manticore image: the mariadb one fails.
# One table at a time: a damaged table must not fail the whole backup.
# A dump cut short would break the restore, so only a complete one is kept.
: >manticore.sql
for table in tag1 note1 audit1; do
    if ! podman exec manticore-app mysqldump -h127.0.0.1 -P9306 \
        --no-create-info \
        --replace \
        --skip-add-locks \
        --skip-lock-tables \
        --no-tablespaces \
        --column-statistics=0 \
        manticore "${table}" >manticore.sql.part; then
        echo "Warning: the ${table} table cannot be read and is left out of the backup." >&2
        continue
    fi
    cat manticore.sql.part >>manticore.sql
done
rm -f manticore.sql.part
