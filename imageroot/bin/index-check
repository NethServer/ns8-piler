# SPDX-License-Identifier: GPL-3.0-or-later
#

# Runs before piler-app accepts mail: once new mail is indexed, MAX(id) of
# piler1 no longer shows the gap left by a restore or a lost binlog.

set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

state=reindex.state

mariadb() {
    podman exec mariadb-app mysql -N -s -e "USE piler; $1"
}

# The manticore client draws a table even with -B: keep the first number.
manticore() {
    podman exec manticore-app mysql -h127.0.0.1 -P9306 -N -B -e "$1" | awk 'match($0, /[0-9]+/) { print substr($0, RSTART, RLENGTH); exit }'
}

# Kept short: the wait counts in the start timeout of piler-app.
for ((i = 0; i < 30; i++)); do
    if mariadb "SELECT 1" >/dev/null 2>&1 && manticore "SHOW TABLES" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! hi=$(mariadb "SELECT COALESCE(MAX(id), 0) FROM metadata WHERE deleted=0") ||
    ! lo=$(manticore "SELECT MAX(id) FROM piler1"); then
    echo "Warning: mariadb-app or manticore-app is not ready, the search index is not checked."
    exit 0
fi
lo=${lo:-0}

if [ -f "${state}" ]; then
    read -r next to <"${state}"
    # Mail indexed during the interrupted rebuild can be lost with the binlog.
    if [ "${hi}" -gt "${to}" ]; then
        to=${hi}
    fi
elif [ "${lo}" -lt "${hi}" ]; then
    next=$((lo + 1))
    to=${hi}
    echo "The search index stops at id ${lo}, the archive at ${hi}: it is rebuilt in the background."
else
    exit 0
fi

printf '%d %d\n' "${next}" "${to}" >"${state}.tmp"
mv "${state}.tmp" "${state}"
